<!DOCTYPE html>
<html>
<head>
    <title>NoSQL Injection Demo</title>

    <style>

        body{
            font-family: Arial;
            padding: 40px;
        }

        input{
            width: 300px;
            padding: 10px;
            margin-top: 10px;
        }

        button{
            padding: 10px 20px;
            margin-top: 20px;
        }

    </style>

</head>

<body>

    <h1>MongoDB Login</h1>

    <form action="/login" method="POST">

        <div>
            <label>Username</label>
            <br>

            <input
                type="text"
                name="username"
                placeholder='"admin"'
                required
            >
        </div>

        <div>
            <label>Password</label>
            <br>

            <input
                type="text"
                name="password"
                placeholder='"admin123"'
                required
            >
        </div>

        <button type="submit">
            Login
        </button>

    </form>

</body>
</html>