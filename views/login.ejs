<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>NoSQL Injection Demo</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <div class="container">

        <h1>NoSQL Injection Demo</h1>

        <form action="/login" method="POST">

            <div class="input-group">

                <label>Username</label>

                <input
                    type="text"
                    name="username"
                    placeholder='"admin"'
                    required
                >

            </div>

            <div class="input-group">

                <label>Password</label>

                <input
                    type="text"
                    name="password"
                    placeholder='"admin123"'
                    required
                >

            </div>

            <button type="submit">
                Login
            </button>

        </form>

    </div>

</body>

</html>